  "interaction": {"enabled": true},
  "inspector": {"enabled": false, "writable": false},
  "longTasks": false,
  "extras": false,
  "remoteOps": {"enabled": false},
  "specialistWorkers": [],
  "communityWorkerPresets": []
}
